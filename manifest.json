{
  "manifest_version": 3,
  "name": "Context Exporter",
  "version": "1.3.3",
  "description": "Export full ChatGPT, Claude & Gemini conversations to Word, PDF and Markdown, with embedded images and math. 100% local, no account, nothing uploaded.",
  "minimum_chrome_version": "110",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://files.oaiusercontent.com/*",
    "https://images.openai.com/*",
    "https://*.oaistatic.com/*",
    "https://*.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Context Exporter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": [
        "content/common.js",
        "content/scroll.js",
        "exporters/markdown.js",
        "exporters/html-doc.js",
        "exporters/word.js",
        "exporters/pdf.js",
        "exporters/mdtext.js",
        "content/adapter-chatgpt.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content/common.js",
        "content/scroll.js",
        "exporters/markdown.js",
        "exporters/html-doc.js",
        "exporters/word.js",
        "exporters/pdf.js",
        "exporters/mdtext.js",
        "content/adapter-claude.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "content/common.js",
        "content/scroll.js",
        "exporters/markdown.js",
        "exporters/html-doc.js",
        "exporters/word.js",
        "exporters/pdf.js",
        "content/adapter-gemini.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
